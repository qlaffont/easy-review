    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "@tanstack/store": "^0.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "gemoji": "^8.1.0",
    "lucide-react": "^0.577.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "mermaid": "^11.17.2",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "radix-ui": "^1.6.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
