{
    "sortImports": {
        "groups": [
            "type-import",
            [
                "value-builtin",
                "value-external"
            ],
            "type-internal",
            "value-internal",
            [
                "type-parent",
                "type-sibling",
                "type-index"
            ],
            [
                "value-parent",
                "value-sibling",
                "value-index"
            ],
            "unknown"
        ]
    },
    "printWidth": 120,
    "tabWidth": 4,
    "sortPackageJson": {
        "sortScripts": true
    },
    "ignorePatterns": [
        "dist/**",
        "*.gen.*"
    ]
}
