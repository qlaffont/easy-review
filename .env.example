# GitHub App credentials (server-only — never prefix with VITE_)
# Create under GitHub → Settings → Developer settings → GitHub Apps (not “OAuth Apps”).
# Full steps: docs/github-setup.md
# Client ID must start with Iv (e.g. Iv1. or Iv23).
# Callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=Iv1.
GITHUB_CLIENT_SECRET=
# Public slug from github.com/apps/<slug> (Install App button on the sign-in page)
GITHUB_APP_SLUG=

# Optional: dedicated secret for encrypting refresh tokens in httpOnly cookies (32+ random chars).
# Falls back to GITHUB_CLIENT_SECRET when unset. Set in production for defense in depth.
# GITHUB_SESSION_SECRET=

# Optional public site URL (absolute og:image / Slack unfurls)
# VITE_APP_URL=https://review.example.com

# Optional client title
# VITE_APP_TITLE=Easy Review

# Dev-only: use in-memory fixtures instead of GitHub
# VITE_FAKE_GITHUB=1
