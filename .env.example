# GitHub OAuth App credentials (server-only — never prefix with VITE_)
# Prefer a classic OAuth App (Client ID starts with Iv1.), not a GitHub App (Ov23…).
# Create at https://github.com/settings/developers → OAuth Apps
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional client title
# VITE_APP_TITLE=Easy Review

# Dev-only: use in-memory fixtures instead of GitHub
# VITE_FAKE_GITHUB=1
